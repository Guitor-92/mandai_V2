# URL de conexão do Postgres (Neon). Sem esta variável, a API sobe com os
# repositórios em memória (dados de prisma/seed-data.ts) — ver ADR sobre o
# fallback in-memory e docs/qa/00-briefing-do-lead.md, seção D.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Porta do servidor local.
PORT=3001
